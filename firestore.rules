rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isActive() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && myProfile().get('disabled', false) != true;
    }
    function isAdmin() {
      return isActive() && myProfile().get('role', '') == 'admin';
    }

    match /users/{uid} {
      allow read:  if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin();
    }

    match /projects/{id} {
      allow read:   if isAdmin() || (isActive() && resource.data.get('createdBy','') == request.auth.uid);
      allow create: if isActive() && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /logs/{id} {
      allow read: if isAdmin()
        || (isActive() && (resource.data.get('uid','') == request.auth.uid
                         || resource.data.get('targetUid','') == request.auth.uid));
      allow create: if isActive() && request.resource.data.uid == request.auth.uid;
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /ideas/{id} {
      allow read:   if isActive();
      allow create: if isActive() && request.resource.data.createdBy == request.auth.uid;
      allow update: if isActive();
      allow delete: if isAdmin();
    }

    match /config/{doc} {
      allow read:  if isActive();
      allow write: if isAdmin();
    }

    match /{other=**} { allow read, write: if false; }
  }
}
