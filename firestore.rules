rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function profile()  { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function isActive() { return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && profile().disabled != true; }
    function isAdmin()  { return isActive() && profile().role == 'admin'; }

    match /users/{uid} {
      allow read:  if signedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin();
    }

    match /projects/{id} {
      allow read:   if isAdmin() || (isActive() && resource.data.createdBy == request.auth.uid);
      allow create: if isActive() && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /logs/{id} {
      allow read:  if isAdmin() || (isActive() && (resource.data.uid == request.auth.uid || resource.data.targetUid == request.auth.uid));
      allow create: if isActive() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    match /ideas/{id} {
      allow read: if isActive();
      allow create: if isActive() && request.resource.data.createdBy == request.auth.uid;
      allow update: if isActive();
      allow delete: if isAdmin();
    }

    match /config/{doc} {
      allow read:  if isActive();
      allow write: if isAdmin();
    }

    match /{other=**} { allow read, write: if false; }
  }
}
